/**
 * made for u — founder notifications
 * --------------------------------------------------------------------------
 * Sends Coralie an email the moment something happens that she may want to
 * respond to:
 *    • a new user joins            (new doc in  profiles/{handle})
 *    • someone posts a request     (new doc in  requests/{id})
 *    • someone styles a request    (new doc in  outfits/{id})
 *
 * Email is sent via Resend (https://resend.com). Because the emails go to
 * your OWN address, you can use Resend's built-in test sender
 * (onboarding@resend.dev) with NO domain verification needed — you only need
 * an API key. Sign up with the same email you want to receive at.
 *
 * The triggers fire server-side, so they're reliable regardless of whether
 * the user's browser stays open after they post.
 */

const { onDocumentCreated } = require('firebase-functions/v2/firestore');
const { defineSecret } = require('firebase-functions/params');
const logger = require('firebase-functions/logger');

// Resend API key — stored as a secret, never hard-coded. Set it once with:
//   firebase functions:secrets:set RESEND_API_KEY
const RESEND_API_KEY = defineSecret('RESEND_API_KEY');

// ---- Config you can tweak --------------------------------------------------
const TO = 'coraliehvon@gmail.com';                 // where alerts are sent
const FROM = 'made for u <onboarding@resend.dev>';  // Resend test sender (no domain needed)
const APP_URL = 'https://madeforu.app/';
const SELF_HANDLE = 'coco';   // your handle — we DON'T email you about your own activity
// ---------------------------------------------------------------------------

// Minimal HTML-escape so handles / free text can't break the email markup.
const esc = (s) =>
  String(s == null ? '' : s).replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' }[c]));

const isSelf = (h) => (h || '').toLowerCase() === SELF_HANDLE.toLowerCase();

// Tiny shared email shell so every alert looks consistent.
function shell(title, bodyHtml, ctaLabel) {
  return `
    <div style="font-family:-apple-system,Segoe UI,Roboto,sans-serif;max-width:480px;margin:0 auto;color:#121722">
      <h2 style="font-size:18px;margin:0 0 12px">${esc(title)}</h2>
      ${bodyHtml}
      <p style="margin-top:20px">
        <a href="${APP_URL}" style="display:inline-block;background:#121722;color:#fff;text-decoration:none;padding:10px 20px;border-radius:20px;font-size:14px">${esc(ctaLabel)}</a>
      </p>
      <p style="color:#8C96A0;font-size:12px;margin-top:24px">made for u · automated notification</p>
    </div>`;
}

async function sendEmail(subject, html) {
  const key = RESEND_API_KEY.value();
  if (!key) {
    logger.error('RESEND_API_KEY is not set — skipping email.');
    return;
  }
  try {
    const res = await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${key}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ from: FROM, to: TO, subject, html }),
    });
    if (!res.ok) {
      logger.error('Resend send failed', { status: res.status, body: await res.text() });
    } else {
      logger.info('Notification email sent', { subject });
    }
  } catch (e) {
    logger.error('Error sending email', e);
  }
}

/* ── 1. New user joined ──────────────────────────────────────────────────
   A profiles/{handle} doc is created when someone claims a handle, i.e. a
   real signup (anonymous guests don't get one until they pick a handle). */
exports.onNewUser = onDocumentCreated(
  { document: 'profiles/{handleId}', secrets: [RESEND_API_KEY] },
  async (event) => {
    const d = (event.data && event.data.data()) || {};
    const handle = d.handle || event.params.handleId;
    await sendEmail(
      `🎉 New user joined: @${handle}`,
      shell(
        'New user on made for u',
        `<p style="font-size:15px;line-height:1.5"><b>@${esc(handle)}</b> just created an account.</p>`,
        'Open the app'
      )
    );
  }
);

/* ── 2. New styling request ──────────────────────────────────────────────
   requests/{id} — the request fields come straight from your addRequest():
   handle, text, body, reqType ('style' | 'buy'), visibility, isPrivate,
   pinnedPieces[]. */
exports.onNewRequest = onDocumentCreated(
  { document: 'requests/{reqId}', secrets: [RESEND_API_KEY] },
  async (event) => {
    const d = (event.data && event.data.data()) || {};
    const who = d.handle || 'someone';

    if (isSelf(who)) return; // don't notify you about your own test requests

    const type = d.reqType === 'buy' ? 'Considering buying' : 'Piece to style';
    const vis = d.isPrivate || d.visibility === 'private' ? 'Private' : 'Public';
    const text = d.text || d.body || '(no description given)';
    const pieces = Array.isArray(d.pinnedPieces) ? d.pinnedPieces.length : 0;

    await sendEmail(
      `🧥 New request from @${who}`,
      shell(
        'New styling request',
        `<p style="font-size:15px;line-height:1.5"><b>@${esc(who)}</b> posted a request.</p>
         <table style="font-size:14px;line-height:1.8;color:#3a4654;margin:8px 0">
           <tr><td style="color:#8C96A0;padding-right:12px">Type</td><td>${esc(type)}</td></tr>
           <tr><td style="color:#8C96A0;padding-right:12px">Visibility</td><td>${esc(vis)}</td></tr>
           <tr><td style="color:#8C96A0;padding-right:12px">Pieces attached</td><td>${pieces}</td></tr>
         </table>
         <p style="font-size:14px;line-height:1.5;background:#F5F7F9;padding:12px 14px;border-radius:10px">
           <span style="color:#8C96A0">What they said:</span><br>${esc(text)}
         </p>`,
        'Go answer it →'
      )
    );
  }
);

/* ── 3. A request got styled ─────────────────────────────────────────────
   outfits/{id} — fields from addOutfit(): forHandle (who it's styled for),
   stylist (the author), prompt. Falls back across a few possible author
   field names to be safe. */
exports.onNewOutfit = onDocumentCreated(
  { document: 'outfits/{outfitId}', secrets: [RESEND_API_KEY] },
  async (event) => {
    const d = (event.data && event.data.data()) || {};
    const stylist = d.stylist || d.handle || d.byHandle || 'someone';
    const forHandle = d.forHandle || 'someone';

    if (isSelf(stylist)) return; // you styling requests is the norm — don't self-spam

    const prompt = d.prompt || d.note || '';
    await sendEmail(
      `✨ @${stylist} styled a look for @${forHandle}`,
      shell(
        'New look posted',
        `<p style="font-size:15px;line-height:1.5"><b>@${esc(stylist)}</b> styled a look for <b>@${esc(forHandle)}</b>.</p>
         ${prompt ? `<p style="font-size:14px;line-height:1.5;background:#F5F7F9;padding:12px 14px;border-radius:10px">${esc(prompt)}</p>` : ''}`,
        'See the look →'
      )
    );
  }
);
